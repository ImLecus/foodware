# Variables de entorno de Foodware.
# Copia este fichero a `.env` y ajusta los valores si hace falta.
# Ningún fichero `.env` con valores reales se versiona en el repositorio.

# --- Backend (Express + SQLite) ---
PORT=3000
# Ruta del fichero SQLite. En Docker se usa /app/data/foodware.db (volumen).
DB_PATH=./data/foodware.db
# Origen permitido por CORS (el frontend en desarrollo).
CORS_ORIGIN=http://localhost:5173
# Minutos de inactividad tras los que se libera el bloqueo de edición (historia 002).
BLOQUEO_INACTIVIDAD_MINUTOS=15

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000/api
